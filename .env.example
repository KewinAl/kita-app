# --- Supabase (Auth + optional Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" on public demos to require login for /prototype routes (uses middleware).
NEXT_PUBLIC_REQUIRE_AUTH=false

# --- Postgres (Supabase → Project Settings → Database) ---
# Pooled URL (Transaction mode, port 6543) for the app / Prisma Client. Use the pooler host + ?pgbouncer=true.
DATABASE_URL=
# Direct URL (session mode, port 5432 on pooler) for prisma migrate / prisma db push. Supabase dashboard shows both under Connection pooling.
DIRECT_URL=

# Optional: service role for admin scripts only — never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=
