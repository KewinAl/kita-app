{
  "name": "kita-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "lint": "next lint",
    "wf:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/git-sync-check.ps1",
    "wf:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/start-worksession.ps1",
    "wf:dev:update": "powershell -ExecutionPolicy Bypass -File ./scripts/start-worksession.ps1 -UpdateDeps",
    "wf:update:deps": "powershell -ExecutionPolicy Bypass -File ./scripts/project-update.ps1",
    "wf:update:system": "powershell -ExecutionPolicy Bypass -File ./scripts/system-update.ps1",
    "wf:verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-workflow.ps1",
    "wf:verify:build": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-workflow.ps1 -Build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
