{
  "name": "kita-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "wf:sync": "powershell -ExecutionPolicy Bypass -File ./scripts/git-sync-check.ps1",
    "wf:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/start-worksession.ps1",
    "wf:dev:update": "powershell -ExecutionPolicy Bypass -File ./scripts/start-worksession.ps1 -UpdateDeps",
    "wf:update:deps": "powershell -ExecutionPolicy Bypass -File ./scripts/project-update.ps1",
    "wf:update:system": "powershell -ExecutionPolicy Bypass -File ./scripts/system-update.ps1",
    "wf:verify": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-workflow.ps1",
    "wf:verify:build": "powershell -ExecutionPolicy Bypass -File ./scripts/verify-workflow.ps1 -Build"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "@radix-ui/react-slot": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "eslint": "^9",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "autoprefixer": "^10"
  }
}
